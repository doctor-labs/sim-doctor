            [CompletionResult]::new('enable', 'enable', [CompletionResultType]::ParameterValue, 'Enable a profile (lpac `profile enable`, ES10c EnableProfile with REFRESH). A dry run unless `--yes`: switches the active profile and the device loses its connection until it re-attaches. Never exposed over MCP')
            [CompletionResult]::new('disable', 'disable', [CompletionResultType]::ParameterValue, 'Disable a profile (lpac `profile disable`, ES10c DisableProfile with REFRESH). A dry run unless `--yes`: disabling the only enabled profile leaves no active profile. Never exposed over MCP')
            [CompletionResult]::new('delete', 'delete', [CompletionResultType]::ParameterValue, 'Delete a profile (lpac `profile delete`, ES10c DeleteProfile). A dry run unless `--yes`: the profile is erased permanently and can only come back by downloading it again from the operator. An enabled profile is refused. Never exposed over MCP')
            [CompletionResult]::new('reset', 'reset', [CompletionResultType]::ParameterValue, 'Reset the eUICC memory (lpac `chip purge`, ES10c eUICCMemoryReset). Can erase every profile: nothing is selected by default, and sending needs both `--yes` and `--confirm-eid <EID>` matching the card. Never exposed over MCP')
            [CompletionResult]::new('set-default-dp', 'set-default-dp', [CompletionResultType]::ParameterValue, 'Set the default SM-DP+ address (ES10a SetDefaultDpAddress, SGP.22 v2.5 clause 5.7.4). A write: a dry run that opens no reader unless `--yes`, and it changes where the eUICC looks for profiles. Never exposed over MCP')
            [CompletionResult]::new('store-data', 'store-data', [CompletionResultType]::ParameterValue, 'One operator-supplied ES10x request, sent to the ISD-R as raw STORE DATA: the escape hatch for a function this tool does not implement (pySim-shell `do_es10x_store_data`). A dry run unless `--yes`: the card may act on an arbitrary ES10 request in ways this tool cannot undo. No keys are involved - this is not SCP03 - so none are asked for. The payload is bounded and refused above it, hex or stdin, and the card answer is reported verbatim even when this tool cannot decode it. Never exposed over MCP')
            break
