            [CompletionResult]::new('--dialect', '--dialect', [CompletionResultType]::ParameterName, 'Which FCP tag table the card answers SELECT with (see `scan --help`)')
            [CompletionResult]::new('-c', '-c', [CompletionResultType]::ParameterName, 'Run these `;`-separated commands and exit')
            [CompletionResult]::new('--script', '--script', [CompletionResultType]::ParameterName, 'Run the commands in this file, one per line (`#` starts a comment), and exit')
            [CompletionResult]::new('--read-csv', '--read-csv', [CompletionResultType]::ParameterName, 'Run the commands in the `command` column of this CSV file, one per row, and exit. This is a command table, not pySim''s provisioning CSV (no ICCID, IMSI or Ki columns). Each row is one command exactly as typed; without `--yes` a row that changes the card is a dry run. WARNING: terminate_df, terminate_ef, terminate_card_usage and deactivate_file can permanently disable a file or the card, and delete_data and delete_all permanently destroy data')
            [CompletionResult]::new('--write-csv', '--write-csv', [CompletionResultType]::ParameterName, 'Append a redacted result log to this CSV file: one row per command run (`command,ok,text`), with the arguments replaced by `<args redacted>`. It is not pySim''s provisioning CSV and cannot be read back as one. A new file starts with the header row; blank and comment lines are not logged')
            [CompletionResult]::new('--chv-file', '--chv-file', [CompletionResultType]::ParameterName, 'File holding PINs, PUKs and ADM keys for `verify_chv` / `unblock_chv` (`pin1=1234` per line; keep it chmod 600). Never a value on the command line: it would land in shell history')
            [CompletionResult]::new('--chv-env', '--chv-env', [CompletionResultType]::ParameterName, 'Environment variable holding the same text (entries separated by `;` or newlines)')
            [CompletionResult]::new('--key-file', '--key-file', [CompletionResultType]::ParameterName, 'pySim CardKeyProvider CSV file for `query_card_key` (ICCID,ADM1,OPC,...; one card per row). Read and checked before any reader is opened; secrets are never printed unless named in --fields. Keep it chmod 600')
            [CompletionResult]::new('--dump', '--dump', [CompletionResultType]::ParameterName, 'Write every APDU exchange (command and response, hex) to FILE as JSON lines, in the SIM_DOCTOR_RECORD replay format. The data field of secret instructions (VERIFY, CHANGE, ENABLE/DISABLE, RESET RETRY COUNTER, AUTHENTICATE) is redacted as FF bytes, and so are the response data of AUTHENTICATE (RES, CK, IK, Kc); such lines carry "redacted":true and no longer replay byte for byte. --dump-secrets records them raw. The file holds raw card data (ICCID, IMSI, file contents): review it before it goes anywhere. Refuses an existing file unless --force; never writes through a symlink or into a non-regular file. The file is owner-only (0600)')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Print every reply as one JSON record (for agents)')
            [CompletionResult]::new('-X', '-X ', [CompletionResultType]::ParameterName, 'Open the reader in exclusive mode (PC/SC SCARD_SHARE_EXCLUSIVE): no other process can use the card while this shell is open. Off by default, which shares it')
            [CompletionResult]::new('--exclusive', '--exclusive', [CompletionResultType]::ParameterName, 'Open the reader in exclusive mode (PC/SC SCARD_SHARE_EXCLUSIVE): no other process can use the card while this shell is open. Off by default, which shares it')
            [CompletionResult]::new('--yes', '--yes', [CompletionResultType]::ParameterName, 'Send the commands that change the card (APDUs outside the read-only set, PIN checks, ...). Without it they print what they would send and the card is not touched by them')
            [CompletionResult]::new('--force', '--force', [CompletionResultType]::ParameterName, 'Let --dump overwrite an existing regular file')
            [CompletionResult]::new('--dump-secrets', '--dump-secrets', [CompletionResultType]::ParameterName, 'Record PINs and keys in plain text: the data field of VERIFY, CHANGE, ENABLE/DISABLE, RESET RETRY COUNTER and AUTHENTICATE, and the response data of AUTHENTICATE (RES, CK, IK, Kc), is written raw. Keep the file private. Needs --dump')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
