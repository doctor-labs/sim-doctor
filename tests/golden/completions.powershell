
using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'sim-doctor' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'sim-doctor'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'sim-doctor' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('modules', 'modules', [CompletionResultType]::ParameterValue, 'Describe the crate module roots and the layering between them')
            [CompletionResult]::new('readers', 'readers', [CompletionResultType]::ParameterValue, 'List the PC/SC readers by name and index, for --reader or --reader-index')
            [CompletionResult]::new('scan', 'scan', [CompletionResultType]::ParameterValue, 'Select a card''s master file, walk everything under it, and report')
            [CompletionResult]::new('profile', 'profile', [CompletionResultType]::ParameterValue, 'Print the card-profile database, or probe a card against it')
            [CompletionResult]::new('cards', 'cards', [CompletionResultType]::ParameterValue, 'List known card profiles, show one, or write its fixture document')
            [CompletionResult]::new('ts48', 'ts48', [CompletionResultType]::ParameterValue, 'Compare a card against the public GSMA TS.48 test profile')
            [CompletionResult]::new('batch', 'batch', [CompletionResultType]::ParameterValue, 'Program a batch of cards, one at a time, with a crash-safe state file')
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Write agent guidance (Claude skill, Cursor rule, AGENTS.md block) into a project')
            [CompletionResult]::new('ci', 'ci', [CompletionResultType]::ParameterValue, 'Write the GitHub Actions workflow that runs this repo''s action on pull requests')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Write a shell completion script to stdout')
            [CompletionResult]::new('mcp', 'mcp', [CompletionResultType]::ParameterValue, 'Serve the scan and the rules as MCP tools over stdio')
            [CompletionResult]::new('rules', 'rules', [CompletionResultType]::ParameterValue, 'List the rules a scan runs, or explain one, without a card')
            [CompletionResult]::new('why', 'why', [CompletionResultType]::ParameterValue, 'Explain a rule, or every rule in a saved `scan --json` envelope')
            [CompletionResult]::new('fix', 'fix', [CompletionResultType]::ParameterValue, 'Hand one finding from a saved scan to a coding agent')
            [CompletionResult]::new('gp', 'gp', [CompletionResultType]::ParameterValue, 'Read-only GlobalPlatform queries')
            [CompletionResult]::new('trace', 'trace', [CompletionResultType]::ParameterValue, 'Decode a captured APDU trace offline (no card, no reader)')
            [CompletionResult]::new('cat', 'cat', [CompletionResultType]::ParameterValue, 'Decode Card Application Toolkit data offline (no card, no reader)')
            [CompletionResult]::new('sms', 'sms', [CompletionResultType]::ParameterValue, '`sms decode` decodes SMS TPDUs offline (TS 23.040): SMS-DELIVER, SMS-SUBMIT and STATUS-REPORT, addresses, DCS, the user-data header and concatenation, GSM 7-bit and UCS2 text. Sends nothing')
            [CompletionResult]::new('saip', 'saip', [CompletionResultType]::ParameterValue, '`saip parse` decodes a SIMalliance eUICC profile package (SAIP, the DER ProfileElement sequence) offline into JSON: each element named by its PE type, the rest a bounded TLV tree. Parse only, no personalization. Sends nothing')
            [CompletionResult]::new('ota-crypto', 'ota-crypto', [CompletionResultType]::ParameterValue, 'Offline OTA ciphers and checksums (DES, 3DES, AES-CBC encrypt/decrypt, CBC-MAC / AES-CMAC sign and check), as pySim''s OTA layer uses them. No card and no reader: pure crypto over hex given on the command line')
            [CompletionResult]::new('esim-cert', 'esim-cert', [CompletionResultType]::ParameterValue, 'Verify an eSIM certificate chain offline, up to a CI root you supply')
            [CompletionResult]::new('ota-expanded', 'ota-expanded', [CompletionResultType]::ParameterValue, 'Offline OTA expanded-command and Proof-of-Response decoder, as pySim''s OTA layer uses them. No card and no reader: hex in, hex out')
            [CompletionResult]::new('keygen', 'keygen', [CompletionResultType]::ParameterValue, 'Generate one card''s Ki, OPc, ICCID and IMSI from a secret you hold')
            [CompletionResult]::new('fuzz', 'fuzz', [CompletionResultType]::ParameterValue, 'APDU discovery and the OTA/SMS fuzz sweep')
            [CompletionResult]::new('euicc', 'euicc', [CompletionResultType]::ParameterValue, 'eUICC queries over ES10 (lpac: chip info, profile list, notification list), and the profile and notification writes')
            [CompletionResult]::new('card', 'card', [CompletionResultType]::ParameterValue, 'A pySim-shell style shell over the card: select files, read them, send APDUs')
            [CompletionResult]::new('erase', 'erase', [CompletionResultType]::ParameterValue, 'Erase the provisioning records before programming: the reference programming tool''s -e/--erase, as a command of its own')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;modules' {
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit the JSON envelope on stdout instead of a human-readable table')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'sim-doctor;readers' {
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope (type "readers") on stdout, and nothing else')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;scan' {
            [CompletionResult]::new('--dialect', '--dialect', [CompletionResultType]::ParameterName, 'Which FCP tag table this card answers SELECT with')
            [CompletionResult]::new('--reader', '--reader', [CompletionResultType]::ParameterName, 'The reader to use, matched against the driver''s own name')
            [CompletionResult]::new('--reader-index', '--reader-index', [CompletionResultType]::ParameterName, 'The reader to use, by its index in `sim-doctor readers` (counted from 0)')
            [CompletionResult]::new('--max-depth', '--max-depth', [CompletionResultType]::ParameterName, 'Deepest path below the master file the walk descends into')
            [CompletionResult]::new('--max-children', '--max-children', [CompletionResultType]::ParameterName, 'Identifiers probed per directory')
            [CompletionResult]::new('--max-nodes', '--max-nodes', [CompletionResultType]::ParameterName, 'Files the card selected across the whole walk (default 16384)')
            [CompletionResult]::new('--max-directories', '--max-directories', [CompletionResultType]::ParameterName, 'Directories whose children are enumerated')
            [CompletionResult]::new('--severity', '--severity', [CompletionResultType]::ParameterName, 'Drop findings below this severity')
            [CompletionResult]::new('--baseline', '--baseline', [CompletionResultType]::ParameterName, 'Compare this run against a previous `scan --json` envelope (doctor/1)')
            [CompletionResult]::new('--fail-on', '--fail-on', [CompletionResultType]::ParameterName, 'Exit 1 (3 under --baseline) when a finding is at or above this severity')
            [CompletionResult]::new('--sarif', '--sarif', [CompletionResultType]::ParameterName, 'Also write the findings to FILE as SARIF 2.1.0')
            [CompletionResult]::new('--csv', '--csv', [CompletionResultType]::ParameterName, 'The same results as a CSV log, in the layout SIMTester writes')
            [CompletionResult]::new('--tar', '--tar', [CompletionResultType]::ParameterName, 'Which TARs to probe for MSL 0, and how many')
            [CompletionResult]::new('--tar-filter', '--tar-filter', [CompletionResultType]::ParameterName, 'SIMTester''s `-stre`: skip TAR probes whose response matches this regex')
            [CompletionResult]::new('--class', '--class', [CompletionResultType]::ParameterName, 'The class byte the ENVELOPE and its CAT follow-ups are sent at: etsi (CLA 80, the default) or gsm (CLA A0).')
            [CompletionResult]::new('--face', '--face', [CompletionResultType]::ParameterName, 'The human report: a doctor-kit face (rich, plain or compact), or the full legacy report')
            [CompletionResult]::new('--theme', '--theme', [CompletionResultType]::ParameterName, 'The face''s colours: mono, clinical or contrast (default: the tool''s own)')
            [CompletionResult]::new('--color', '--color', [CompletionResultType]::ParameterName, 'Colour the face: auto (a terminal and no NO_COLOR), always or never')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope on stdout, and nothing else')
            [CompletionResult]::new('--tui', '--tui', [CompletionResultType]::ParameterName, 'Show the findings in an interactive terminal view instead of the report')
            [CompletionResult]::new('-b', '-b', [CompletionResultType]::ParameterName, 'Break after finding all files the card claims to have (DF count matches)')
            [CompletionResult]::new('--scan-file-break', '--scan-file-break', [CompletionResultType]::ParameterName, 'Break after finding all files the card claims to have (DF count matches)')
            [CompletionResult]::new('--sfb', '--sfb', [CompletionResultType]::ParameterName, 'Break after finding all files the card claims to have (DF count matches)')
            [CompletionResult]::new('--sffs', '--sffs', [CompletionResultType]::ParameterName, 'Follow standard identifiers only (ETSI TS 102 221 / 3GPP TS 31.102 / 31.103 / 31.104 / 51.011). When set, the walk probes only the file identifiers defined in the ETSI and 3GPP specifications, plus the files pySim can decode with standard names. This is stricter than the default (SimFamilies), which probes the broader GSM 11.11 family ranges (2Fxx, 4Fxx, 5Fxx, 6Fxx, 7Fxx). Corresponds to SIMTester''s `-sffs` flag')
            [CompletionResult]::new('--score', '--score', [CompletionResultType]::ParameterName, 'Add one quality score for this card, for CI gating')
            [CompletionResult]::new('--terminal-profile', '--terminal-profile', [CompletionResultType]::ParameterName, 'Send a TERMINAL PROFILE to the card before the TAR audit')
            [CompletionResult]::new('--sms-deliver-report', '--sms-deliver-report', [CompletionResultType]::ParameterName, 'Ask for SMS-DELIVER-REPORT as the proof-of-receipt mode of the TAR probes, not SMS-SUBMIT')
            [CompletionResult]::new('--reserved-file-ids', '--reserved-file-ids', [CompletionResultType]::ParameterName, 'Scan reserved file identifiers 7FF0-7FFF inside an application')
            [CompletionResult]::new('--sfrv', '--sfrv', [CompletionResultType]::ParameterName, 'Scan reserved file identifiers 7FF0-7FFF inside an application')
            [CompletionResult]::new('--tar-uncapped', '--tar-uncapped', [CompletionResultType]::ParameterName, 'Raise the 4096-probe bound on the TAR audit to a ceiling of 1 000 000 probes (issue #266)')
            [CompletionResult]::new('--headless', '--headless', [CompletionResultType]::ParameterName, 'A face in plain text without colour, for CI and pipes')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;profile' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'Print the card-profile database with its provenance. Needs no card')
            [CompletionResult]::new('probe', 'probe', [CompletionResultType]::ParameterValue, 'Probe a card and report which profiles matched, with the evidence')
            [CompletionResult]::new('match', 'match', [CompletionResultType]::ParameterValue, 'Check one named profile against a card. An unknown name is refused before any reader is opened')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;profile;list' {
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope instead of the table')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'sim-doctor;profile;probe' {
            [CompletionResult]::new('--reader', '--reader', [CompletionResultType]::ParameterName, 'Which PC/SC reader to use')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope instead of the report')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'sim-doctor;profile;match' {
            [CompletionResult]::new('--reader', '--reader', [CompletionResultType]::ParameterName, 'Which PC/SC reader to use')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope instead of the report')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'sim-doctor;profile;help' {
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'Print the card-profile database with its provenance. Needs no card')
            [CompletionResult]::new('probe', 'probe', [CompletionResultType]::ParameterValue, 'Probe a card and report which profiles matched, with the evidence')
            [CompletionResult]::new('match', 'match', [CompletionResultType]::ParameterValue, 'Check one named profile against a card. An unknown name is refused before any reader is opened')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;profile;help;list' {
            break
        }
        'sim-doctor;profile;help;probe' {
            break
        }
        'sim-doctor;profile;help;match' {
            break
        }
        'sim-doctor;profile;help;help' {
            break
        }
        'sim-doctor;cards' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'Print the card table: name, stated JavaCard and GlobalPlatform versions, stated EEPROM size, and which heading of the reference lists it')
            [CompletionResult]::new('show', 'show', [CompletionResultType]::ParameterValue, 'Print one card profile in full, with every note and every provenance record')
            [CompletionResult]::new('fixture', 'fixture', [CompletionResultType]::ParameterValue, 'Write one card profile''s fixture document to stdout')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;cards;list' {
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope (type "cards") on stdout, and nothing else')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'sim-doctor;cards;show' {
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope (type "cards") on stdout, and nothing else')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'sim-doctor;cards;fixture' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;cards;help' {
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'Print the card table: name, stated JavaCard and GlobalPlatform versions, stated EEPROM size, and which heading of the reference lists it')
            [CompletionResult]::new('show', 'show', [CompletionResultType]::ParameterValue, 'Print one card profile in full, with every note and every provenance record')
            [CompletionResult]::new('fixture', 'fixture', [CompletionResultType]::ParameterValue, 'Write one card profile''s fixture document to stdout')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;cards;help;list' {
            break
        }
        'sim-doctor;cards;help;show' {
            break
        }
        'sim-doctor;cards;help;fixture' {
            break
        }
        'sim-doctor;cards;help;help' {
            break
        }
        'sim-doctor;ts48' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('compare', 'compare', [CompletionResultType]::ParameterValue, 'Walk the card and diff its file system against the GSMA TS.48 test profile')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;ts48;compare' {
            [CompletionResult]::new('--reader', '--reader', [CompletionResultType]::ParameterName, 'The reader to use, matched against the driver''s own name')
            [CompletionResult]::new('--dialect', '--dialect', [CompletionResultType]::ParameterName, 'Which FCP tag table this card answers SELECT with (see `scan --help`)')
            [CompletionResult]::new('--max-depth', '--max-depth', [CompletionResultType]::ParameterName, 'Deepest path below the master file the walk descends into')
            [CompletionResult]::new('--max-children', '--max-children', [CompletionResultType]::ParameterName, 'Identifiers probed per directory')
            [CompletionResult]::new('--max-nodes', '--max-nodes', [CompletionResultType]::ParameterName, 'Files the card selected across the whole walk (default 16384)')
            [CompletionResult]::new('--max-directories', '--max-directories', [CompletionResultType]::ParameterName, 'Directories whose children are enumerated')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Emit one JSON envelope (type "ts48") on stdout, and nothing else')
            [CompletionResult]::new('-b', '-b', [CompletionResultType]::ParameterName, 'Break after finding all files the card claims to have (DF count matches)')
            [CompletionResult]::new('--scan-file-break', '--scan-file-break', [CompletionResultType]::ParameterName, 'Break after finding all files the card claims to have (DF count matches)')
            [CompletionResult]::new('--sfb', '--sfb', [CompletionResultType]::ParameterName, 'Break after finding all files the card claims to have (DF count matches)')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;ts48;help' {
            [CompletionResult]::new('compare', 'compare', [CompletionResultType]::ParameterValue, 'Walk the card and diff its file system against the GSMA TS.48 test profile')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;ts48;help;compare' {
            break
        }
        'sim-doctor;ts48;help;help' {
            break
        }
        'sim-doctor;batch' {
            [CompletionResult]::new('--plan', '--plan', [CompletionResultType]::ParameterName, 'The plan: a `sim-doctor-batch-plan/1` JSON document naming every card, its ICCID and the commands to send it. Read and checked in full before any card is touched')
            [CompletionResult]::new('--state', '--state', [CompletionResultType]::ParameterName, 'The state file. The only record of which cards are programmed and verified; its absence means the batch has not started, and an unreadable one stops the run rather than restarting it')
            [CompletionResult]::new('--reader', '--reader', [CompletionResultType]::ParameterName, 'The reader to use, matched against the driver''s own name (default: the first reader)')
            [CompletionResult]::new('--on-failure', '--on-failure', [CompletionResultType]::ParameterName, 'Whether a card that failed lets the run go on to the next one. `stop` (the default) ends the run at the first failure; `continue` goes on and the report says which card was left behind and why. A swapped card stops the run either way')
            [CompletionResult]::new('--batch-name', '--batch-name', [CompletionResultType]::ParameterName, 'The batch''s name, recorded in the state file (default: the plan''s `batch`, or `batch`)')
            [CompletionResult]::new('--handler', '--handler', [CompletionResultType]::ParameterName, 'A feeder instead of a person: `get = command`, `done = command` and `error = command`, one per line (`#` starts a comment). The command is run directly, not through a shell')
            [CompletionResult]::new('--chv-file', '--chv-file', [CompletionResultType]::ParameterName, 'File holding PINs, PUKs and ADM keys for plan commands that need them (`pin1=1234` per line; keep it chmod 600). Never a value on the command line: it would land in shell history')
            [CompletionResult]::new('--chv-env', '--chv-env', [CompletionResultType]::ParameterName, 'Environment variable holding the same text (entries separated by `;` or newlines)')
            [CompletionResult]::new('--yes', '--yes', [CompletionResultType]::ParameterName, 'Send the batch. Without it, every card''s plan is printed and not one byte is sent')
            [CompletionResult]::new('--retry-failed', '--retry-failed', [CompletionResultType]::ParameterName, 'Attempt again a card an earlier run failed on for a reason that will not fix itself. Cards that failed because no card was there are retried without this')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Print one JSON envelope on stdout, and nothing else')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;install' {
            [CompletionResult]::new('--agent', '--agent', [CompletionResultType]::ParameterName, 'Install for one agent only; omit for all of them')
            [CompletionResult]::new('--dir', '--dir', [CompletionResultType]::ParameterName, 'Project root to write under (default: the current directory)')
            [CompletionResult]::new('--print-only', '--print-only', [CompletionResultType]::ParameterName, 'Print what would be written instead of writing it')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;ci' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Write .github/workflows/sim-doctor.yml, pinned to this version''s tag')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;ci;install' {
            [CompletionResult]::new('--swsim', '--swsim', [CompletionResultType]::ParameterName, 'Build the software card on the runner (CI has no card otherwise)')
            [CompletionResult]::new('--baseline', '--baseline', [CompletionResultType]::ParameterName, 'Committed baseline path (letters, digits and . _ / - only)')
            [CompletionResult]::new('--require-baseline', '--require-baseline', [CompletionResultType]::ParameterName, 'Fail the job when the baseline file is missing')
            [CompletionResult]::new('--severity', '--severity', [CompletionResultType]::ParameterName, 'Pass --severity to the scan')
            [CompletionResult]::new('--ref', '--ref', [CompletionResultType]::ParameterName, 'The action ref to pin (default: v<this version>; it exists once that release is cut)')
            [CompletionResult]::new('--dir', '--dir', [CompletionResultType]::ParameterName, 'Project root to write under (default: the current directory)')
            [CompletionResult]::new('--force', '--force', [CompletionResultType]::ParameterName, 'Overwrite a differing existing workflow')
            [CompletionResult]::new('--print-only', '--print-only', [CompletionResultType]::ParameterName, 'Print the workflow instead of writing it')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'sim-doctor;ci;help' {
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Write .github/workflows/sim-doctor.yml, pinned to this version''s tag')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'sim-doctor;ci;help;install' {
            break
        }
        'sim-doctor;ci;help;help' {
            break
        }
        'sim-doctor;completions' {
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
