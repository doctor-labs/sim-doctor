            [CompletionResult]::new('disable', 'disable', [CompletionResultType]::ParameterValue, 'Disable a profile (lpac `profile disable`, ES10c DisableProfile with REFRESH). A dry run unless `--yes`: disabling the only enabled profile leaves no active profile. Never exposed over MCP')
