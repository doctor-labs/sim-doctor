            [CompletionResult]::new('--exclusive', '--exclusive', [CompletionResultType]::ParameterName, 'Open the reader in exclusive mode (PC/SC SCARD_SHARE_EXCLUSIVE): no other process can use the card while this shell is open. Off by default, which shares it')
            [CompletionResult]::new('--yes', '--yes', [CompletionResultType]::ParameterName, 'Send the commands that change the card (APDUs outside the read-only set, PIN checks, ...). Without it they print what they would send and the card is not touched by them')
