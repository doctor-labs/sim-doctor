        'sim-doctor;help;gp' {
            [CompletionResult]::new('cert', 'cert', [CompletionResultType]::ParameterValue, '`gp cert`: the GlobalPlatform card certificate of tag 7F21 (SCP11)')
            [CompletionResult]::new('info', 'info', [CompletionResultType]::ParameterValue, 'Select the issuer security domain and read CPLC, card data, key information, IIN and CIN with GET DATA')
            [CompletionResult]::new('ara', 'ara', [CompletionResultType]::ParameterValue, 'Select the ARA-M (Access Rule Application Master) and read every access rule with GET DATA [all], decoded (read-only, no keys)')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'GlobalPlatform registry inventory: GET STATUS for the ISD, applications and load files, plus Card Recognition Data (read-only). A scope the card only gives over a secure channel is reported as requiring authentication')
            [CompletionResult]::new('select', 'select', [CompletionResultType]::ParameterValue, 'SELECT a GlobalPlatform (or any) application by AID and report the status word and the FCI. Read-only, no keys; it only changes the card''s current selection')
            [CompletionResult]::new('crs', 'crs', [CompletionResultType]::ParameterValue, 'Contactless Registry Service (CRS, GlobalPlatform Amendment C): list the applications held for contactless, read the service version and event counter, and activate or deactivate one application for contactless')
            [CompletionResult]::new('channel', 'channel', [CompletionResultType]::ParameterValue, 'Open or close a supplementary logical channel (MANAGE CHANNEL). A channel stays open on the card until it is closed or the card loses power, and the other gp commands can then run on it with --channel N')
            [CompletionResult]::new('release-scp', 'release-scp', [CompletionResultType]::ParameterValue, 'Release the SCP03 secure channel on a logical channel: close that logical channel with MANAGE CHANNEL, which is what ends the secure channel the card holds there. CHANGES CARD SESSION STATE')
            [CompletionResult]::new('delete', 'delete', [CompletionResultType]::ParameterValue, 'Delete an application or an executable load file over an SCP03 channel (DELETE, GlobalPlatform Card Spec v2.3.1 11.2). CHANGES CARD CONTENT')
            [CompletionResult]::new('make-default', 'make-default', [CompletionResultType]::ParameterValue, 'Make an installed application Default Selected over an SCP03 channel: INSTALL [for make selectable] with the Card Reset privilege (GlobalPlatform Card Spec v2.3.1 11.5, Table 11-7). CHANGES CARD CONTENT')
            [CompletionResult]::new('rename-isd', 'rename-isd', [CompletionResultType]::ParameterValue, 'Rename the Issuer Security Domain over an SCP03 channel: STORE DATA `4F LEN AID` (GlobalPlatform Card Spec v2.3.1 11.11). CHANGES CARD CONTENT')
            [CompletionResult]::new('delete-key', 'delete-key', [CompletionResultType]::ParameterValue, 'Delete a key from the issuer security domain over an SCP03 channel (DELETE KEY, GlobalPlatform Card Spec v2.3.1 11.2.2). CHANGES CARD STATE')
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Install an applet over an SCP03 channel (GlobalPlatform Card Spec v2.3.1 11.5, 11.6; v2.4 11.5.2.3.5). CHANGES CARD CONTENT: every form writes to the card registry, and none of them can be undone')
            [CompletionResult]::new('create-sd', 'create-sd', [CompletionResultType]::ParameterValue, 'Create a supplementary Security Domain over an SCP03 channel: INSTALL [for install and make selectable] carrying the Security Domain privileges and the allow-to / allow-from install parameters (GlobalPlatform Card Spec v2.3.1 11.5, Tables 11-43 and 11-49). CHANGES CARD CONTENT')
            [CompletionResult]::new('put-key', 'put-key', [CompletionResultType]::ParameterValue, 'Add or replace an SCP03 key set (ENC, MAC, DEK; AES-128) in the issuer security domain over an SCP03 channel (PUT KEY, GlobalPlatform Card Spec v2.3.1 11.8). CAN PERMANENTLY LOCK THE CARD''S ADMINISTRATIVE ACCESS')
            [CompletionResult]::new('cplc-set', 'cplc-set', [CompletionResultType]::ParameterValue, 'Write the CPLC pre-personalization or personalization block (STORE DATA with DGI 9F67 or 9F66, GlobalPlatformPro --set-pre-perso and --set-perso) over SCP03. WARNING: this writes card-identifying CPLC data, and the change can be permanent on a card that locks its CPLC')
            [CompletionResult]::new('personalize', 'personalize', [CompletionResultType]::ParameterValue, 'Personalize an application or Security Domain over an SCP03 channel: INSTALL [for personalization] (P1 20) for the AID, then one STORE DATA with the BER-TLV data (GlobalPlatform Card Spec v2.3.1; the layout is unverified against the spec text, see the source). CHANGES CARD CONTENT')
            [CompletionResult]::new('aram', 'aram', [CompletionResultType]::ParameterValue, 'Add, delete or lock the secure element access rules the ARA-M holds: STORE DATA [Command-Store-REF-AR-DO], [Command-Delete] and the fork''s lock, all over an SCP03 channel. CHANGES THE CARD''S ACCESS RULES')
            [CompletionResult]::new('move', 'move', [CompletionResultType]::ParameterValue, 'Move an object (an application, a load file or a key object) from one Security Domain to another: INSTALL [for extradition], P1 10 (GlobalPlatform Card Spec v2.3.1 11.5.2.3.4), which is ONE command and not a DELETE followed by an INSTALL. CHANGES CARD CONTENT')
            [CompletionResult]::new('receipt', 'receipt', [CompletionResultType]::ParameterValue, 'Verify a GlobalPlatform receipt: check that the receipt a Security Domain returned is the signature its receipt generation key makes over the response''s Confirmation Data and the AIDs the operation named (GlobalPlatform Card Specification v2.3.1 C.5, Tables C-11 to C-16; Confirmation Data is Table 11-14). READ-ONLY: no card is opened and nothing is sent, so the receipt may come from a response you captured yourself')
            [CompletionResult]::new('store-data', 'store-data', [CompletionResultType]::ParameterValue, 'Write data to the selected Application or issuer security domain with STORE DATA (GlobalPlatform Card Spec v2.3.1 11.11). CHANGES CARD CONTENT')
            [CompletionResult]::new('secure-apdu', 'secure-apdu', [CompletionResultType]::ParameterValue, 'Send ONE raw APDU you wrote over the SCP03 secure channel and report the card''s answer verbatim. This is the raw escape hatch of the GP tool (`gp -s`), not a new kind of command. CAN WRITE TO THE CARD')
            break
        }
