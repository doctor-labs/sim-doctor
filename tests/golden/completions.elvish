        &'sim-doctor;ota-crypto'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand encrypt 'Encrypt DATA (hex) with CBC, no padding, printing ciphertext as hex'
            cand decrypt 'Decrypt ciphertext (hex) with CBC, no padding, printing plaintext as hex'
            cand sign 'Compute an OTA checksum (AES-CMAC for AES, CBC-MAC for DES/3DES)'
            cand check 'Recompute the checksum and compare it to --mac in constant time'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;ota-crypto;encrypt'= {
            cand --alg 'DES (8-byte key), 3DES (16- or 24-byte key) or AES (16/24/32-byte key)'
            cand --key 'The key as hex; length selects the AES variant (16/24/32) or must match the algorithm (DES 8, 3DES 16 or 24)'
            cand --iv 'The IV as hex (one block); all zeros when absent'
            cand --json 'Emit one JSON envelope of kind "ota-crypto" on stdout'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;ota-crypto;decrypt'= {
