            cand --max-segment 'Most data bytes in one STORE DATA block, 1 to 255 (default 120, as lpac; 255 is the short-APDU Lc limit). Some eUICCs reject full 255-byte blocks'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;euicc;notifications'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --aid 'ISD-R AID as hex (default A0000005591010FFFFFFFF8900000100)'
            cand --max-segment 'Most data bytes in one STORE DATA block, 1 to 255 (default 120, as lpac; 255 is the short-APDU Lc limit). Some eUICCs reject full 255-byte blocks'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
            cand remove 'Remove a notification from the eUICC''s list (lpac `notification remove`, ES10b RemoveNotificationFromList). A dry run unless `--yes`: a removed notification is never sent to the operator''s server. Never exposed over MCP'
            cand dump 'Read the full signed pending notifications (lpac `notification dump`, ES10b RetrieveNotificationsList) as a re-loadable JSON document: hex of the signed bytes plus the decoded sequence number, operation, address and ICCID. Read-only: nothing is removed. Without `-o` and `--json` the document itself is printed. Never exposed over MCP'
            cand replay 'Send the notifications of a dump file to their operators (ES9+ HandleNotification over HTTPS). A dry run unless `--yes`: this reaches the network and tells the operator''s server about a profile event. Needs no card and removes nothing. Never exposed over MCP'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;euicc;notifications;remove'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --aid 'ISD-R AID as hex (default A0000005591010FFFFFFFF8900000100)'
            cand --max-segment 'Most data bytes in one STORE DATA block, 1 to 255 (default 120, as lpac; 255 is the short-APDU Lc limit). Some eUICCs reject full 255-byte blocks'
            cand --yes 'Send the request, then re-read the list and confirm. Without it nothing is changed'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;euicc;notifications;dump'= {
            cand --seq 'Only the notification with this sequence number (default: all pending)'
            cand -o 'Write the dump document to FILE (must not exist) instead of stdout'
            cand --output 'Write the dump document to FILE (must not exist) instead of stdout'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --aid 'ISD-R AID as hex (default A0000005591010FFFFFFFF8900000100)'
            cand --max-segment 'Most data bytes in one STORE DATA block, 1 to 255 (default 120, as lpac; 255 is the short-APDU Lc limit). Some eUICCs reject full 255-byte blocks'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;euicc;notifications;replay'= {
            cand --from 'A dump file written by `notifications dump` (or its `--json` output)'
            cand --yes 'Actually send. Without it nothing leaves this machine: the targets and what would be sent are printed'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;euicc;notifications;help'= {
            cand remove 'Remove a notification from the eUICC''s list (lpac `notification remove`, ES10b RemoveNotificationFromList). A dry run unless `--yes`: a removed notification is never sent to the operator''s server. Never exposed over MCP'
            cand dump 'Read the full signed pending notifications (lpac `notification dump`, ES10b RetrieveNotificationsList) as a re-loadable JSON document: hex of the signed bytes plus the decoded sequence number, operation, address and ICCID. Read-only: nothing is removed. Without `-o` and `--json` the document itself is printed. Never exposed over MCP'
