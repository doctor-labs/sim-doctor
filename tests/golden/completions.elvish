
use builtin;
use str;

set edit:completion:arg-completer[sim-doctor] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'sim-doctor'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'sim-doctor'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand modules 'Describe the crate module roots and the layering between them'
            cand readers 'List the PC/SC readers by name and index, for --reader or --reader-index'
            cand scan 'Select a card''s master file, walk everything under it, and report'
            cand ts48 'Compare a card against the public GSMA TS.48 test profile'
            cand install 'Write agent guidance (Claude skill, Cursor rule, AGENTS.md block) into a project'
            cand ci 'Write the GitHub Actions workflow that runs this repo''s action on pull requests'
            cand completions 'Write a shell completion script to stdout'
            cand mcp 'Serve the scan and the rules as MCP tools over stdio'
            cand rules 'List the rules a scan runs, or explain one, without a card'
            cand why 'Explain a rule, or every rule in a saved `scan --json` envelope'
            cand fix 'Hand one finding from a saved scan to a coding agent'
            cand gp 'Read-only GlobalPlatform queries'
            cand trace 'Decode a captured APDU trace offline (no card, no reader)'
            cand cat 'Decode Card Application Toolkit data offline (no card, no reader)'
            cand sms '`sms decode` decodes SMS TPDUs offline (TS 23.040): SMS-DELIVER, SMS-SUBMIT and STATUS-REPORT, addresses, DCS, the user-data header and concatenation, GSM 7-bit and UCS2 text. Sends nothing'
            cand saip '`saip parse` decodes a SIMalliance eUICC profile package (SAIP, the DER ProfileElement sequence) offline into JSON: each element named by its PE type, the rest a bounded TLV tree. Parse only, no personalization. Sends nothing'
            cand ota-crypto 'Offline OTA ciphers and checksums (DES, 3DES, AES-CBC encrypt/decrypt, CBC-MAC / AES-CMAC sign and check), as pySim''s OTA layer uses them. No card and no reader: pure crypto over hex given on the command line'
            cand esim-cert 'Verify an eSIM certificate chain offline, up to a CI root you supply'
            cand fuzz 'APDU discovery and the OTA/SMS fuzz sweep'
            cand euicc 'eUICC queries over ES10 (lpac: chip info, profile list, notification list), and the profile and notification writes'
            cand card 'A pySim-shell style shell over the card: select files, read them, send APDUs'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;modules'= {
            cand --json 'Emit the JSON envelope on stdout instead of a human-readable table'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;readers'= {
            cand --json 'Emit one JSON envelope (type "readers") on stdout, and nothing else'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;scan'= {
            cand --dialect 'Which FCP tag table this card answers SELECT with'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --reader-index 'The reader to use, by its index in `sim-doctor readers` (counted from 0)'
            cand --max-depth 'Deepest path below the master file the walk descends into'
            cand --max-children 'Identifiers probed per directory'
            cand --max-nodes 'Files the card selected across the whole walk (default 16384)'
            cand --max-directories 'Directories whose children are enumerated'
            cand --severity 'Drop findings below this severity'
            cand --baseline 'Compare this run against a previous `scan --json` envelope (doctor/1)'
            cand --fail-on 'Exit 1 (3 under --baseline) when a finding is at or above this severity'
            cand --sarif 'Also write the findings to FILE as SARIF 2.1.0'
            cand --tar 'Which TARs to probe for MSL 0, and how many'
            cand --face 'The human report: a doctor-kit face (rich, plain or compact), or the full legacy report'
            cand --theme 'The face''s colours: mono, clinical or contrast (default: the tool''s own)'
            cand --color 'Colour the face: auto (a terminal and no NO_COLOR), always or never'
            cand --json 'Emit one JSON envelope on stdout, and nothing else'
            cand --tui 'Show the findings in an interactive terminal view instead of the report'
            cand --sffs 'Follow standard identifiers only (ETSI TS 102 221 / 3GPP TS 31.102 / 31.103 / 31.104 / 51.011). When set, the walk probes only the file identifiers defined in the ETSI and 3GPP specifications, plus the files pySim can decode with standard names. This is stricter than the default (SimFamilies), which probes the broader GSM 11.11 family ranges (2Fxx, 4Fxx, 5Fxx, 6Fxx, 7Fxx). Corresponds to SIMTester''s `-sffs` flag'
            cand --score 'Add one quality score for this card, for CI gating'
            cand --terminal-profile 'Send a TERMINAL PROFILE to the card before the TAR audit'
            cand --sms-deliver-report 'Ask for SMS-DELIVER-REPORT as the proof-of-receipt mode of the TAR probes, not SMS-SUBMIT'
            cand --headless 'A face in plain text without colour, for CI and pipes'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;ts48'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand compare 'Walk the card and diff its file system against the GSMA TS.48 test profile'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;ts48;compare'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --dialect 'Which FCP tag table this card answers SELECT with (see `scan --help`)'
            cand --max-depth 'Deepest path below the master file the walk descends into'
            cand --max-children 'Identifiers probed per directory'
            cand --max-nodes 'Files the card selected across the whole walk (default 16384)'
            cand --max-directories 'Directories whose children are enumerated'
            cand --json 'Emit one JSON envelope (type "ts48") on stdout, and nothing else'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;ts48;help'= {
            cand compare 'Walk the card and diff its file system against the GSMA TS.48 test profile'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;ts48;help;compare'= {
        }
        &'sim-doctor;ts48;help;help'= {
        }
        &'sim-doctor;install'= {
            cand --agent 'Install for one agent only; omit for all of them'
            cand --dir 'Project root to write under (default: the current directory)'
            cand --print-only 'Print what would be written instead of writing it'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;ci'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand install 'Write .github/workflows/sim-doctor.yml, pinned to this version''s tag'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;ci;install'= {
            cand --swsim 'Build the software card on the runner (CI has no card otherwise)'
            cand --baseline 'Committed baseline path (letters, digits and . _ / - only)'
            cand --require-baseline 'Fail the job when the baseline file is missing'
            cand --severity 'Pass --severity to the scan'
            cand --ref 'The action ref to pin (default: v<this version>; it exists once that release is cut)'
            cand --dir 'Project root to write under (default: the current directory)'
            cand --force 'Overwrite a differing existing workflow'
            cand --print-only 'Print the workflow instead of writing it'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;ci;help'= {
            cand install 'Write .github/workflows/sim-doctor.yml, pinned to this version''s tag'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;ci;help;install'= {
        }
        &'sim-doctor;ci;help;help'= {
        }
        &'sim-doctor;completions'= {
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;mcp'= {
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;rules'= {
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand list 'One row per rule: id, severity, summary'
            cand explain 'What a rule means and how to fix it'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;rules;list'= {
            cand --json 'Emit one JSON envelope of kind "rules" on stdout'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;rules;explain'= {
            cand --json 'Emit one JSON envelope of kind "rules" on stdout'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;rules;help'= {
            cand list 'One row per rule: id, severity, summary'
            cand explain 'What a rule means and how to fix it'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;rules;help;list'= {
        }
        &'sim-doctor;rules;help;explain'= {
        }
        &'sim-doctor;rules;help;help'= {
        }
        &'sim-doctor;why'= {
            cand --json 'Emit one JSON envelope of kind "rules" on stdout'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;fix'= {
            cand --from 'A saved `sim-doctor scan --json` envelope holding a finding for that rule'
            cand --agent 'Start this coding agent with the prompt instead of only printing it'
            cand --skip-approvals 'Pass the agent its flag that skips approval prompts (unverified for every CLI version)'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp'= {
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand info 'Select the issuer security domain and read CPLC, card data, key information, IIN and CIN with GET DATA'
            cand ara 'Select the ARA-M (Access Rule Application Master) and read every access rule with GET DATA [all], decoded (read-only, no keys)'
            cand status 'GlobalPlatform registry inventory: GET STATUS for the ISD, applications and load files, plus Card Recognition Data (read-only). A scope the card only gives over a secure channel is reported as requiring authentication'
            cand select 'SELECT a GlobalPlatform (or any) application by AID and report the status word and the FCI. Read-only, no keys; it only changes the card''s current selection'
            cand channel 'Open or close a supplementary logical channel (MANAGE CHANNEL). A channel stays open on the card until it is closed or the card loses power, and the other gp commands can then run on it with --channel N'
            cand delete 'Delete an application or an executable load file over an SCP03 channel (DELETE, GlobalPlatform Card Spec v2.3.1 11.2). CHANGES CARD CONTENT'
            cand make-default 'Make an installed application Default Selected over an SCP03 channel: INSTALL [for make selectable] with the Card Reset privilege (GlobalPlatform Card Spec v2.3.1 11.5, Table 11-7). CHANGES CARD CONTENT'
            cand rename-isd 'Rename the Issuer Security Domain over an SCP03 channel: STORE DATA `4F LEN AID` (GlobalPlatform Card Spec v2.3.1 11.11). CHANGES CARD CONTENT'
            cand install 'Load a CAP file and install an applet over an SCP03 channel: INSTALL [for load], LOAD, INSTALL [for install and make selectable] (GlobalPlatform Card Spec v2.3.1 11.5, 11.6). CHANGES CARD CONTENT'
            cand put-key 'Add or replace an SCP03 key set (ENC, MAC, DEK; AES-128) in the issuer security domain over an SCP03 channel (PUT KEY, GlobalPlatform Card Spec v2.3.1 11.8). CAN PERMANENTLY LOCK THE CARD''S ADMINISTRATIVE ACCESS'
            cand cplc-set 'Write the CPLC pre-personalization or personalization block (STORE DATA with DGI 9F67 or 9F66, GlobalPlatformPro --set-pre-perso and --set-perso) over SCP03. WARNING: this writes card-identifying CPLC data, and the change can be permanent on a card that locks its CPLC'
            cand personalize 'Personalize an application or Security Domain over an SCP03 channel: INSTALL [for personalization] (P1 20) for the AID, then one STORE DATA with the BER-TLV data (GlobalPlatform Card Spec v2.3.1; the layout is unverified against the spec text, see the source). CHANGES CARD CONTENT'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;gp;info'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;ara'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;status'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --list 'Print the registry as a table: scope, AID, lifecycle, privileges'
            cand --info 'Print each registry entry in detail, with its raw lifecycle and privilege bytes'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;select'= {
            cand --aid 'The application AID, 5 to 16 bytes of hex'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;channel'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand open 'MANAGE CHANNEL open: the card picks the number and it is printed'
            cand close 'MANAGE CHANNEL close of a channel opened earlier'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;gp;channel;open'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;gp;channel;close'= {
            cand --channel 'The channel to close, 1 to 19'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;gp;channel;help'= {
            cand open 'MANAGE CHANNEL open: the card picks the number and it is printed'
            cand close 'MANAGE CHANNEL close of a channel opened earlier'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;gp;channel;help;open'= {
        }
        &'sim-doctor;gp;channel;help;close'= {
        }
        &'sim-doctor;gp;channel;help;help'= {
        }
        &'sim-doctor;gp;delete'= {
            cand --aid 'The AID to delete, 5 to 16 bytes of hex'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --related 'Also delete related objects (P2 80): for a load file, its applications'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;make-default'= {
            cand --aid 'The application AID, 5 to 16 bytes of hex'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;rename-isd'= {
            cand --new-aid 'The new ISD AID, 5 to 16 bytes of hex'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;install'= {
            cand --load 'The CAP file (a zip of javacard/*.cap components)'
            cand --module 'The Executable Module AID (the applet class). Optional when the CAP has one applet'
            cand --app 'The application (instance) AID. Defaults to the module AID'
            cand --params 'The Install Parameters field as TLV with the mandatory C9 tag (default C900: none)'
            cand --privileges 'Privileges, 1 or 3 bytes of hex (default 000000). Card Lock and Card Terminate are refused'
            cand --dap-key-file 'File holding the AES DAP key (hex, optionally KEY/KCV; chmod 600)'
            cand --dap-key-env 'Environment variable holding the AES DAP key'
            cand --dap-sd 'The Security Domain that verifies the DAP, 5 to 16 bytes of hex (default: the issuer security domain being authenticated)'
            cand --dap-hash 'The Load File Data Block Hash the DAP signs'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --make-default 'Make the applet default selected: sets the Card Reset privilege, 0x04 in the first privilege byte (GP Card Spec v2.3.1 table 11-7, the bit GlobalPlatformPro''s --make-default sets). The card then selects this applet by default after reset, so it changes what the card runs first'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;put-key'= {
            cand --new-key-version 'The Key Version Number of the new keys, 01 to 7F'
            cand --replace-key-version 'P1: 00 (default) adds the key set; 01 to 7F replaces the key set with that version'
            cand --key-id 'The Key Identifier of the first key (the other two follow at +1 and +2)'
            cand --new-keys-file 'File holding the new keys (keep it chmod 600)'
            cand --new-keys-env 'Environment variable holding the new keys'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --replace-current-keyset 'Allow the request to add, replace or overwrite the key version this session authenticated with. Without it such a request is refused'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;cplc-set'= {
            cand --kind 'pre-perso (DGI 9F67) or perso (DGI 9F66)'
            cand --data 'The eight data bytes of the block as 16 hex digits'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --today 'Write today''s date (UTC) into the date bytes, overriding those in --data'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;personalize'= {
            cand --aid 'The application or Security Domain AID, 5 to 16 bytes of hex'
            cand --data 'The BER-TLV personalization data, as hex; sent as the STORE DATA body'
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --keys-file 'File holding the keys (keep it chmod 600)'
            cand --keys-env 'Environment variable holding the keys'
            cand --key-version 'Key version number for INITIALIZE UPDATE, two hex digits; 00 (default) lets the card choose its first key set'
            cand --channel 'Logical channel number, 0 (the basic channel, default) to 19. The SELECT and every following command, and the secure channel, use it'
            cand --json 'Emit one JSON envelope of kind "gp" on stdout'
            cand --trace 'Add every APDU exchange (command and response hex) as data.trace'
            cand --yes 'Send the commands. Without it nothing is written. Needs --keys-file or --keys-env'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;gp;help'= {
            cand info 'Select the issuer security domain and read CPLC, card data, key information, IIN and CIN with GET DATA'
            cand ara 'Select the ARA-M (Access Rule Application Master) and read every access rule with GET DATA [all], decoded (read-only, no keys)'
            cand status 'GlobalPlatform registry inventory: GET STATUS for the ISD, applications and load files, plus Card Recognition Data (read-only). A scope the card only gives over a secure channel is reported as requiring authentication'
            cand select 'SELECT a GlobalPlatform (or any) application by AID and report the status word and the FCI. Read-only, no keys; it only changes the card''s current selection'
            cand channel 'Open or close a supplementary logical channel (MANAGE CHANNEL). A channel stays open on the card until it is closed or the card loses power, and the other gp commands can then run on it with --channel N'
            cand delete 'Delete an application or an executable load file over an SCP03 channel (DELETE, GlobalPlatform Card Spec v2.3.1 11.2). CHANGES CARD CONTENT'
            cand make-default 'Make an installed application Default Selected over an SCP03 channel: INSTALL [for make selectable] with the Card Reset privilege (GlobalPlatform Card Spec v2.3.1 11.5, Table 11-7). CHANGES CARD CONTENT'
            cand rename-isd 'Rename the Issuer Security Domain over an SCP03 channel: STORE DATA `4F LEN AID` (GlobalPlatform Card Spec v2.3.1 11.11). CHANGES CARD CONTENT'
            cand install 'Load a CAP file and install an applet over an SCP03 channel: INSTALL [for load], LOAD, INSTALL [for install and make selectable] (GlobalPlatform Card Spec v2.3.1 11.5, 11.6). CHANGES CARD CONTENT'
            cand put-key 'Add or replace an SCP03 key set (ENC, MAC, DEK; AES-128) in the issuer security domain over an SCP03 channel (PUT KEY, GlobalPlatform Card Spec v2.3.1 11.8). CAN PERMANENTLY LOCK THE CARD''S ADMINISTRATIVE ACCESS'
            cand cplc-set 'Write the CPLC pre-personalization or personalization block (STORE DATA with DGI 9F67 or 9F66, GlobalPlatformPro --set-pre-perso and --set-perso) over SCP03. WARNING: this writes card-identifying CPLC data, and the change can be permanent on a card that locks its CPLC'
            cand personalize 'Personalize an application or Security Domain over an SCP03 channel: INSTALL [for personalization] (P1 20) for the AID, then one STORE DATA with the BER-TLV data (GlobalPlatform Card Spec v2.3.1; the layout is unverified against the spec text, see the source). CHANGES CARD CONTENT'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
