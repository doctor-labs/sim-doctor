            cand --aid 'ISD-R AID as hex (default A0000005591010FFFFFFFF8900000100)'
            cand --max-segment 'Most data bytes in one STORE DATA block, 1 to 255 (default 120, as lpac; 255 is the short-APDU Lc limit). Some eUICCs reject full 255-byte blocks'
            cand --operational 'Delete the operational profiles (resetOptions bit 0)'
            cand --test 'Delete the field-loaded test profiles (resetOptions bit 1)'
            cand --smdp-address 'Reset the default SM-DP+ address (resetOptions bit 2)'
            cand --yes 'Send the reset (needs `--confirm-eid`), then re-read and confirm. Without it nothing is changed: the profiles that would be erased are listed'
            cand --json 'Emit one lpac envelope on stdout, and nothing else'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'sim-doctor;euicc;help'= {
            cand info 'EID, EUICCInfo1 and EUICCInfo2 (lpac `chip info`)'
            cand profiles 'Installed profiles: ICCID, state, class, nickname, provider, name (lpac `profile list`)'
            cand challenge 'GetEUICCChallenge (ES10b, SGP.22 v2.5 §5.7.7): the 16-byte challenge a profile download signs over (pySim `get_euicc_challenge`). Read-only'
            cand notifications 'Pending notification metadata (lpac `notification list`); `dump` and `replay` below; `notifications remove <seq>` removes one'
            cand nickname 'Set a profile''s nickname (lpac `profile nickname`). A write: a dry run unless `--yes`, never exposed over MCP'
            cand enable 'Enable a profile (lpac `profile enable`, ES10c EnableProfile with REFRESH). A dry run unless `--yes`: switches the active profile and the device loses its connection until it re-attaches. Never exposed over MCP'
            cand disable 'Disable a profile (lpac `profile disable`, ES10c DisableProfile with REFRESH). A dry run unless `--yes`: disabling the only enabled profile leaves no active profile. Never exposed over MCP'
            cand delete 'Delete a profile (lpac `profile delete`, ES10c DeleteProfile). A dry run unless `--yes`: the profile is erased permanently and can only come back by downloading it again from the operator. An enabled profile is refused. Never exposed over MCP'
            cand reset 'Reset the eUICC memory (lpac `chip purge`, ES10c eUICCMemoryReset). Can erase every profile: nothing is selected by default, and sending needs both `--yes` and `--confirm-eid <EID>` matching the card. Never exposed over MCP'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;euicc;help;info'= {
        }
        &'sim-doctor;euicc;help;profiles'= {
        }
        &'sim-doctor;euicc;help;challenge'= {
        }
        &'sim-doctor;euicc;help;notifications'= {
            cand remove 'Remove a notification from the eUICC''s list (lpac `notification remove`, ES10b RemoveNotificationFromList). A dry run unless `--yes`: a removed notification is never sent to the operator''s server. Never exposed over MCP'
            cand dump 'Read the full signed pending notifications (lpac `notification dump`, ES10b RetrieveNotificationsList) as a re-loadable JSON document: hex of the signed bytes plus the decoded sequence number, operation, address and ICCID. Read-only: nothing is removed. Without `-o` and `--json` the document itself is printed. Never exposed over MCP'
            cand replay 'Send the notifications of a dump file to their operators (ES9+ HandleNotification over HTTPS). A dry run unless `--yes`: this reaches the network and tells the operator''s server about a profile event. Needs no card and removes nothing. Never exposed over MCP'
        }
        &'sim-doctor;euicc;help;notifications;remove'= {
        }
        &'sim-doctor;euicc;help;notifications;dump'= {
        }
        &'sim-doctor;euicc;help;notifications;replay'= {
        }
        &'sim-doctor;euicc;help;nickname'= {
        }
        &'sim-doctor;euicc;help;enable'= {
        }
        &'sim-doctor;euicc;help;disable'= {
        }
        &'sim-doctor;euicc;help;delete'= {
        }
        &'sim-doctor;euicc;help;reset'= {
        }
        &'sim-doctor;euicc;help;help'= {
        }
        &'sim-doctor;card'= {
            cand --reader 'The reader to use, matched against the driver''s own name (default: the first reader)'
            cand --profile 'The command set the card speaks: uicc (class 00) or sim (class A0, GSM 11.11)'
            cand --dialect 'Which FCP tag table the card answers SELECT with (see `scan --help`)'
            cand -c 'Run these `;`-separated commands and exit'
            cand --script 'Run the commands in this file, one per line (`#` starts a comment), and exit'
            cand --chv-file 'File holding PINs, PUKs and ADM keys for `verify_chv` / `unblock_chv` (`pin1=1234` per line; keep it chmod 600). Never a value on the command line: it would land in shell history'
            cand --chv-env 'Environment variable holding the same text (entries separated by `;` or newlines)'
            cand --key-file 'pySim CardKeyProvider CSV file for `query_card_key` (ICCID,ADM1,OPC,...; one card per row). Read and checked before any reader is opened; secrets are never printed unless named in --fields. Keep it chmod 600'
            cand --dump 'Write every APDU exchange (command and response, hex) to FILE as JSON lines, in the SIM_DOCTOR_RECORD replay format. The data field of secret instructions (VERIFY, CHANGE, ENABLE/DISABLE, RESET RETRY COUNTER, AUTHENTICATE) is redacted as FF bytes, and so are the response data of AUTHENTICATE (RES, CK, IK, Kc); such lines carry "redacted":true and no longer replay byte for byte. --dump-secrets records them raw. The file holds raw card data (ICCID, IMSI, file contents): review it before it goes anywhere. Refuses an existing file unless --force; never writes through a symlink or into a non-regular file. The file is owner-only (0600)'
            cand --json 'Print every reply as one JSON record (for agents)'
            cand -X 'Open the reader in exclusive mode (PC/SC SCARD_SHARE_EXCLUSIVE): no other process can use the card while this shell is open. Off by default, which shares it'
            cand --exclusive 'Open the reader in exclusive mode (PC/SC SCARD_SHARE_EXCLUSIVE): no other process can use the card while this shell is open. Off by default, which shares it'
            cand --yes 'Send the commands that change the card (APDUs outside the read-only set, PIN checks, ...). Without it they print what they would send and the card is not touched by them'
            cand --force 'Let --dump overwrite an existing regular file'
            cand --dump-secrets 'Record PINs and keys in plain text: the data field of VERIFY, CHANGE, ENABLE/DISABLE, RESET RETRY COUNTER and AUTHENTICATE, and the response data of AUTHENTICATE (RES, CK, IK, Kc), is written raw. Keep the file private. Needs --dump'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;help'= {
            cand modules 'Describe the crate module roots and the layering between them'
            cand readers 'List the PC/SC readers by name and index, for --reader or --reader-index'
            cand scan 'Select a card''s master file, walk everything under it, and report'
            cand ts48 'Compare a card against the public GSMA TS.48 test profile'
            cand install 'Write agent guidance (Claude skill, Cursor rule, AGENTS.md block) into a project'
            cand ci 'Write the GitHub Actions workflow that runs this repo''s action on pull requests'
            cand completions 'Write a shell completion script to stdout'
            cand mcp 'Serve the scan and the rules as MCP tools over stdio'
            cand rules 'List the rules a scan runs, or explain one, without a card'
            cand why 'Explain a rule, or every rule in a saved `scan --json` envelope'
            cand fix 'Hand one finding from a saved scan to a coding agent'
            cand gp 'Read-only GlobalPlatform queries'
            cand trace 'Decode a captured APDU trace offline (no card, no reader)'
            cand cat 'Decode Card Application Toolkit data offline (no card, no reader)'
            cand sms '`sms decode` decodes SMS TPDUs offline (TS 23.040): SMS-DELIVER, SMS-SUBMIT and STATUS-REPORT, addresses, DCS, the user-data header and concatenation, GSM 7-bit and UCS2 text. Sends nothing'
            cand saip '`saip parse` decodes a SIMalliance eUICC profile package (SAIP, the DER ProfileElement sequence) offline into JSON: each element named by its PE type, the rest a bounded TLV tree. Parse only, no personalization. Sends nothing'
            cand ota-crypto 'Offline OTA ciphers and checksums (DES, 3DES, AES-CBC encrypt/decrypt, CBC-MAC / AES-CMAC sign and check), as pySim''s OTA layer uses them. No card and no reader: pure crypto over hex given on the command line'
            cand esim-cert 'Verify an eSIM certificate chain offline, up to a CI root you supply'
            cand fuzz 'APDU discovery and the OTA/SMS fuzz sweep'
            cand euicc 'eUICC queries over ES10 (lpac: chip info, profile list, notification list), and the profile and notification writes'
            cand card 'A pySim-shell style shell over the card: select files, read them, send APDUs'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;help;modules'= {
        }
        &'sim-doctor;help;readers'= {
        }
        &'sim-doctor;help;scan'= {
        }
        &'sim-doctor;help;ts48'= {
            cand compare 'Walk the card and diff its file system against the GSMA TS.48 test profile'
