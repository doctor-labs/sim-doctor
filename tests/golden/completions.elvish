        &'sim-doctor;fuzz'= {
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand apdu 'CLA discovery (level 1) or CLA+INS discovery (level 2) over a session'
            cand ota 'The OTA/SMS fuzz sweep: TAR x keyset x mechanism, built on the TAR scanner''s ENVELOPE builder'
            cand mutate 'Allowlist-only APDU mutation fuzzer, against a replay log or the built-in mock card only (no reader)'
            cand compare 'Compares two or more `fuzz ota` JSON results: keysets ranked by how often the card accepted under them, and the (TAR, keyset, mechanism) triples the runs disagree on. Offline and read-only: it reads result files and sends nothing. Only triples every run probed are compared'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'sim-doctor;fuzz;apdu'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --level '1 for CLA discovery, 2 for CLA+INS discovery'
            cand --class 'The CLA level 2 probes INS values at, as two hex digits (e.g. A0). Required for --level 2'
            cand --i-understand-this-can-brick-the-card 'Required. Without it, `fuzz` refuses to run at all (exit 1, error kind fuzz-needs-opt-in)'
            cand --allow-real-hardware 'Required in addition to the opt-in above when the reader''s name does not match the software card (swicc-pcsc names its reader with "swICC"). Without it, `fuzz` refuses to run against anything that is not recognisably the software card'
            cand --json 'Emit one JSON envelope on stdout, and nothing else'
            cand --quick 'Probe a small, documented subset instead of the full space'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'sim-doctor;fuzz;ota'= {
            cand --reader 'The reader to use, matched against the driver''s own name'
            cand --i-understand-this-can-brick-the-card 'Required. Without it, `fuzz` refuses to run at all (exit 1, error kind fuzz-needs-opt-in)'
            cand --allow-real-hardware 'Required in addition to the opt-in above when the reader''s name does not match the software card (swicc-pcsc names its reader with "swICC"). Without it, `fuzz` refuses to run against anything that is not recognisably the software card'
            cand --json 'Emit one JSON envelope on stdout, and nothing else'
            cand --quick 'Probe a small, documented subset instead of the full space'
            cand -h 'Print help'
            cand --help 'Print help'
        }
